# --- Database (Neon). Do NOT add pgbouncer=true: it makes every query ~5x slower ---
DATABASE_URL=""   # pooled host (…-pooler…)
DIRECT_URL=""     # same URL without "-pooler" (used by prisma db push)

# --- Telegram ---
BOT_TOKEN=""
# Locally use a separate TEST bot token: a local bot must never take over the production webhook.
WEBAPP_URL=""     # public HTTPS URL of the Mini App (Vercel). Empty locally: `npm run tunnel` fills it in.

# --- Server ---
PORT=3001
NODE_ENV=development
ALLOW_DEV_AUTH=true     # browser dev mode on localhost; forced off in production
CORS_ORIGINS=""         # production: https://your-miniapp.vercel.app,https://your-admin.vercel.app

# --- Admin dashboard ---
ADMIN_PASSWORD=""       # production: 12+ characters
JWT_SECRET=""           # production: 32+ characters
ADMIN_LOCAL_ONLY=true   # false in production (admin is served from Vercel)
